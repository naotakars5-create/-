# OpenAI API キー（/api/extract の音声テキスト構造化に使用）
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Maps API キー（/api/fare の運賃自動取得に使用。任意）
# 運賃マスタ（fareMaster.json）にヒットしない区間の運賃を、
# Google Maps の経路検索（Directions API）から自動取得する。
# 未設定でも動作する（その場合は従来どおり手入力にフォールバックする）。
# 取得: https://console.cloud.google.com/google/maps-apis
#   - 「Directions API」を有効化する
#   - 請求先アカウント（クレジットカード）の登録が必要（月200ドル分は無料枠）
GOOGLE_MAPS_API_KEY=
